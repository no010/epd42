{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epd42-pomodoro",
  "version": "0.1.0",
  "identifier": "com.epd42.pomodoro",
  "build": {
    "beforeDevCommand": "node web/scripts/build.mjs",
    "beforeBuildCommand": "node web/scripts/build.mjs",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EPD42 番茄钟",
        "width": 500,
        "height": 830,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}