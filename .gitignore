# A .gitignore for Keil projects.
# Taken mostly from http://www.keil.com/support/man/docs/uv4/uv4_b_filetypes.htm

# User-specific uVision files
*.opt
*.uvopt
*.uvoptx
*.uvgui
*.uvgui.*
*.uvguix.*

# Listing files
*.cod
*.htm
*.i
*.lst
*.map
*.m51
*.m66
# define exception below if needed
*.scr

# Object and HEX files
*.axf
*.b[0-3][0-9]
*.hex
*.d
*.crf
*.elf
*.hex
*.h86
*.lib
*.obj
*.o
*.sbr

# Build files
# define exception below if needed
*.bat
*._ia
*.__i
*._ii

# Generated output files
Keil/Listings/*
Keil/Objects/*
build/
__pycache__/
tools/__pycache__/

# Debugger files
# define exception below if needed
*.ini

# Other files
*.build_log.htm
*.cdb
*.dep
*.ic
*.lin
*.lnp
*.orc
# define exception below if needed
*.pack
# define exception below if needed
*.pdsc
*.plg
# define exception below if needed
*.sct
*.sfd
*.sfr

# Miscellaneous
*.tra
*.bin
*.fed
*.l1p
*.l2p
*.iex

# To explicitly override the above, define any exceptions here; e.g.:
# !my_customized_scatter_file.sct

!/components/softdevice/*/hex/*.hex
RTE_Components.h
EventRecorderStub.scvd
JLinkLog.txt

*.PrjPcbStructure

# uv / Python virtualenv
.venv/

# Local secrets: config.toml holds provider API keys, only the example is tracked
tools/epd-monitor/config.toml

# Frames and previews produced by epd_monitor.py
tools/epd-monitor/preview.png

# Playwright persistent login profiles (session cookies - never commit)
tools/epd-monitor/profiles/
# Local Pomodoro tool state and outputs
tools/epd-pomodoro/config.toml
tools/epd-pomodoro/state.json
tools/epd-pomodoro/state.json.tmp
tools/epd-pomodoro/preview.png
tools/epd-pomodoro/dist/
# Tauri desktop app
desktop/target/
desktop/src-tauri/gen/
desktop/web/node_modules/
desktop/web/dist/
